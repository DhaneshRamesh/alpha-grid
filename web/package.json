{
  "name": "alpha-grid-cockpit",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "schema:generate": "json2ts -i schemas/engine-snapshot.schema.json -o src/generated/engine-snapshot.d.ts && json2ts -i schemas/engine-update.schema.json -o src/generated/engine-update.d.ts && json2ts -i schemas/envelope.schema.json -o src/generated/envelope.d.ts"
  },
  "dependencies": {
    "lightweight-charts": "5.2.1",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.7.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.0.1",
    "globals": "16.5.0",
    "jsdom": "30.1.2",
    "json-schema-to-typescript": "16.0.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.56.0",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  }
}
