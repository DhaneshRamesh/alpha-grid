# Copy to .env for local development. The application reads environment variables;
# export this file or use a process manager to load it.
QUANT_ENVIRONMENT=development
QUANT_LOG_LEVEL=INFO
QUANT_FEED_STALE_AFTER_SECONDS=5

# Dhan 20-level depth. Use your own credentials; never commit a populated .env.
DHAN_CLIENT_ID=
DHAN_ACCESS_TOKEN=
QUANT_DEPTH_RECONNECT_INITIAL_SECONDS=1
QUANT_DEPTH_RECONNECT_MAX_SECONDS=30
QUANT_DEPTH_PAIR_MAX_AGE_SECONDS=2
# 20 verified NSE_EQ IDs from Dhan's instrument master (October 2026).
# Format: exchange_segment:security_id:symbol, up to 50 unique instruments.
QUANT_DEPTH_INSTRUMENTS=NSE_EQ:5900:AXISBANK,NSE_EQ:317:BAJFINANCE,NSE_EQ:10604:BHARTIARTL,NSE_EQ:1333:HDFCBANK,NSE_EQ:1394:HINDUNILVR,NSE_EQ:4963:ICICIBANK,NSE_EQ:1594:INFY,NSE_EQ:1660:ITC,NSE_EQ:1922:KOTAKBANK,NSE_EQ:11483:LT,NSE_EQ:10999:MARUTI,NSE_EQ:11630:NTPC,NSE_EQ:2475:ONGC,NSE_EQ:14977:POWERGRID,NSE_EQ:2885:RELIANCE,NSE_EQ:3045:SBIN,NSE_EQ:3351:SUNPHARMA,NSE_EQ:11536:TCS,NSE_EQ:3506:TITAN,NSE_EQ:11532:ULTRACEMCO
