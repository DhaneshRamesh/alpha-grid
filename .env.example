# Copy to .env for local development. The application reads environment variables;
# export this file or use a process manager to load it.
QUANT_ENVIRONMENT=development
QUANT_LOG_LEVEL=INFO
QUANT_FEED_STALE_AFTER_SECONDS=5

# Dhan 20-level depth. Use your own credentials; never commit a populated .env.
DHAN_CLIENT_ID=
DHAN_ACCESS_TOKEN=
# Separate API-key consent flow and callback service. Export these variables;
# the service does not read .env automatically.
DHAN_API_KEY=
DHAN_API_SECRET=
# Set only after a public HTTPS host routes both Dhan paths to this service.
ALPHA_GRID_PUBLIC_BASE_URL=
QUANT_DEPTH_RECONNECT_INITIAL_SECONDS=1
QUANT_DEPTH_RECONNECT_MAX_SECONDS=30
QUANT_DEPTH_PAIR_MAX_AGE_SECONDS=2
# 20 verified NSE_EQ IDs from Dhan's instrument master (October 2026).
# Format: exchange_segment:security_id:symbol, up to 50 unique instruments.
QUANT_DEPTH_INSTRUMENTS=NSE_EQ:5900:AXISBANK,NSE_EQ:317:BAJFINANCE,NSE_EQ:10604:BHARTIARTL,NSE_EQ:1333:HDFCBANK,NSE_EQ:1394:HINDUNILVR,NSE_EQ:4963:ICICIBANK,NSE_EQ:1594:INFY,NSE_EQ:1660:ITC,NSE_EQ:1922:KOTAKBANK,NSE_EQ:11483:LT,NSE_EQ:10999:MARUTI,NSE_EQ:11630:NTPC,NSE_EQ:2475:ONGC,NSE_EQ:14977:POWERGRID,NSE_EQ:2885:RELIANCE,NSE_EQ:3045:SBIN,NSE_EQ:3351:SUNPHARMA,NSE_EQ:11536:TCS,NSE_EQ:3506:TITAN,NSE_EQ:11532:ULTRACEMCO

# Local append-only journal. Default fsync=always is the safest setting.
QUANT_JOURNAL_DIR=data/journal
# Optional; defaults to NSE-YYYY-MM-DD in Asia/Kolkata, so restarts resume.
QUANT_JOURNAL_SESSION_ID=
QUANT_JOURNAL_FSYNC=always

# Offline journal replay into research Parquet.
QUANT_PARQUET_DIR=data/research_depth
QUANT_PARQUET_BATCH_SIZE=5000
QUANT_PARQUET_BATCH_SECONDS=900
QUANT_PARQUET_ZSTD_LEVEL=3

# Per-instrument feed quality monitoring. Empty/missing exchange timestamps are
# reported as unavailable; the Dhan 20-level wire packet normally omits them.
QUANT_HEALTH_STATUS_PATH=data/feed_health.json
QUANT_HEALTH_DEGRADED_AFTER_SECONDS=2
QUANT_HEALTH_STALE_AFTER_SECONDS=5
QUANT_HEALTH_MISSING_AFTER_SECONDS=5
QUANT_HEALTH_MAX_EXCHANGE_LAG_SECONDS=2
QUANT_HEALTH_STALE_EXCHANGE_LAG_SECONDS=10
QUANT_HEALTH_RATE_WINDOW_SECONDS=60
QUANT_HEALTH_MIN_EVENTS_PER_SECOND=0
QUANT_HEALTH_ISSUE_HOLD_SECONDS=300
QUANT_HEALTH_TIMESTAMP_REGRESSION_TOLERANCE_SECONDS=0
QUANT_HEALTH_FUTURE_TIMESTAMP_TOLERANCE_SECONDS=1
QUANT_HEALTH_POLL_SECONDS=1
QUANT_HEALTH_STATUS_MAX_AGE_SECONDS=3
QUANT_HEALTH_DUPLICATE_HISTORY_SIZE=256
# Dhan says to ignore its header sequence; gaps are observed but not alarming
# until continuity has been verified for your live feed.
QUANT_HEALTH_SEQUENCE_GAPS_DEGRADE=false
